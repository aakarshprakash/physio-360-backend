# Local development defaults. Production template: deploy/.env.production.example
APP_NAME=Physio360
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Generate once, never change: php -r "echo bin2hex(random_bytes(32));"
BLIND_INDEX_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=physio360
DB_USERNAME=physio360
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_COOKIE=physio360_session
AUTH_ABSOLUTE_TIMEOUT=720

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,localhost:5175,127.0.0.1:5173,127.0.0.1:5174,127.0.0.1:5175,localhost:4173,localhost:4174,localhost:4175

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@physio360.local"
MAIL_FROM_NAME="Physio360"

SYSNAC_SUPPORT_EMAIL=support@sysnac.com
SYSNAC_SUPPORT_PHONE="+91 484 000 0000"
SYSNAC_SUPPORT_HOURS="Mon–Sat, 9:00–18:00 IST"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

RAZORPAY_WEBHOOK_TOLERANCE=300
