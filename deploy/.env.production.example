# Production template for api.physio.peoplenex.online (cPanel).
# Copy to .env on the server. Never commit the real .env.
APP_NAME=Physio360
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.physio.peoplenex.online
# The Cloudflare Pages site that proxies /api and /sanctum to this API.
FRONTEND_URL=https://physio-360-frontend-3t7.pages.dev
# Generate once, never change (changing it breaks lookups of encrypted data):
# php -r "echo bin2hex(random_bytes(32));"
BLIND_INDEX_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# cPanel -> MySQL Databases: names are prefixed with the cPanel account name.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=physio360_session
AUTH_ABSOLUTE_TIMEOUT=720

# Browser-facing host (the Pages site), not the API host.
SANCTUM_STATEFUL_DOMAINS=physio-360-frontend-3t7.pages.dev

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_DISK=local
# No Redis/Horizon on shared hosting: queue worker runs from cron (see deploy/CPANEL.md).
QUEUE_CONNECTION=database
CACHE_STORE=database

# Real SMTP is required for reminders/receipts (cPanel -> Email Accounts).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@peoplenex.online"
MAIL_FROM_NAME="Physio360"

SYSNAC_SUPPORT_EMAIL=support@sysnac.com
SYSNAC_SUPPORT_PHONE="+91 484 000 0000"
SYSNAC_SUPPORT_HOURS="Mon–Sat, 9:00–18:00 IST"

RAZORPAY_WEBHOOK_TOLERANCE=300
